(defcfg
  process-unmapped-keys no
)

(defsrc
  7 8 9 0 - = tab w e r t y u i o p [ ] caps s d f g h j k l ; ' z x c v b n m , . / lmet ralt rmet IntlBackslash
)

(deflayer colemak
  _ _ _ _ _ _ @colemak-tab @colemak-w  f p g [ j l u y Slash _ @colemak-caps r s t d ' h n e i o x c v b ; IntlBackslash k m , . _ @colemak-ralt nop0 z
)

(deflayer commands
  _ _ _ _ _ _ _ _ _ _ _ _ _ _ up _ _ _ _ _ (multi lctl c) (multi lctl v) _ _ _ left down right ret _ _ _ _ _ _ _ _ _ _ _ _ _ _
)

(deflayer qwerty
  7 8 9 0 - = tab w e r t y u i o p [ ] caps s d f g h j k l ; ' z x c v b n m , . / lmet @qwerty-ralt nop0 _
)

(deflayer sym
  _ _ _ _ _ _ _ _ S-9 S-0 _ _ Slash BracketRight Backslash _ _ _ lsft _ _ _ _ grv - = \ _ _ _ _ _ _ _ , ' _ _ _ _ _ _ _
)

(defalias
  colemak-tab (tap-hold 200 200 tab lsft)
  colemak-caps (tap-hold 200 200 bspc (layer-while-held commands))
  colemak-w (tap-hold 200 350 w (layer-while-held sym))
  colemak-ralt (layer-switch qwerty)
  qwerty-ralt (layer-switch colemak)
)
